# Local .terraform directories
# (.terraform.lock.hcl is intentionally NOT ignored — commit it per HashiCorp guidance)
**/.terraform/*

# Local persistent agent plans
/plans/

# Local assistant/tool state
/.claude/

# Cloud-specific backend override generated at init time (see backends/)
backend_override.tf
.terraformrc-empty

# Terraform state and plans — never commit
*.tfstate
*.tfstate.*
**/tfplan
**/tfplan.*
**/plan.json

# Credential material — never commit
**/*credentials*.json
**/*service-account*.json
**/gcp-credentials.json
**/*sa-key*.json
**/*-key.json
i-binder-*.json
*.pem
*.p12
*.pfx
kubeconfig
kubeconfig.*

# Environment-specific files
.env
*.auto.tfvars
*.tfvars.local
